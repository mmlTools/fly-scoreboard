autoload -Uz log_error log_status log_info mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  local suffix
  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    local -A arch_mappings=(
      aarch64 arm64
      x86_64 amd64
    )

    suffix=":${arch_mappings[${target##*-}]}"

    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  sudo apt-get update

  sudo apt-get install ${apt_args} \
    build-essential \
    libgles-dev \
    libsimde-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswresample-dev libswscale-dev \
    libjansson-dev libx11-dev libx11-xcb-dev libxcb1-dev libxcb-xinput-dev \
    libdrm-dev libegl-dev libgl-dev libpulse-dev libwayland-dev libxkbcommon-dev \
    uuid-dev uthash-dev zlib1g-dev

  sudo apt-get install ${apt_args} qt6-base-dev${suffix} libqt6svg6-dev${suffix}
  log_group
}

autoload -Uz setup_obs_sdk && setup_obs_sdk
